# Salin ke .env lalu isi dengan kredensial Anda. File .env sudah di-gitignore.

# Access token Facebook/Instagram Graph API.
# Scope wajib: instagram_basic, instagram_manage_insights,
#              pages_read_engagement, pages_show_list
IG_ACCESS_TOKEN=

# ID numerik akun Instagram Business milik Anda sendiri (bukan username).
# Cara ambil: Graph API Explorer -> GET /me/accounts, ambil id Page-nya, lalu
#   GET /{page-id}?fields=instagram_business_account
IG_BUSINESS_ACCOUNT_ID=
